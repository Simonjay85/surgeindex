{
  "name": "surgeindex-collector",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "queues": {
    "producers": [
      {
        "queue": "surgeindex-events",
        "binding": "EVENTS_QUEUE"
      }
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeRoom",
        "script_name": "surgeindex-realtime"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SITE_KEYS",
      "id": "REPLACE_WITH_KV_ID"
    },
    {
      "binding": "EVENT_IDS",
      "id": "REPLACE_WITH_EVENT_ID_KV_ID"
    }
  ],
  "vars": {
    "TRACKER_EVENT_MAX_BODY_BYTES": "65536",
    "EVENT_RETENTION_DAYS": "90"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "surgeindex-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "vars": {
    "APP_MODE": "demo",
    "DATA_PROVIDER": "demo",
    "ANALYTICS_PROVIDER": "postgres",
    "REALTIME_PROVIDER": "local",
    "REALTIME_SERVICE_URL": "https://realtime-staging.example.com",
    "QUEUE_PROVIDER": "local",
    "TRACKER_ENABLED": "false",
    "TRACKER_PUBLIC_URL": "https://cdn-staging.example.com/tracker.js",
    "TRACKER_COLLECTOR_URL": "https://events-staging.example.com/v1/events"
  },
  "kv_namespaces": [
    {
      "binding": "LEADERBOARD_CACHE",
      "id": "REPLACE_WITH_CLOUDFLARE_KV_NAMESPACE_ID"
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "surgeindex-events",
        "binding": "EVENTS_QUEUE"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  }
}

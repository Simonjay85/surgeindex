{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "surgeindex-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },
  "vars": {
    "APP_MODE": "production",
    "DATA_PROVIDER": "postgres",
    "ANALYTICS_PROVIDER": "postgres",
    "REALTIME_PROVIDER": "local",
    "QUEUE_PROVIDER": "local",
    "TRACKER_ENABLED": "false",
    "NEXT_PUBLIC_APP_NAME": "SurgeIndex",
    "NEXT_PUBLIC_APP_URL": "https://surgeindex.lol",
    "BETTER_AUTH_URL": "https://surgeindex.lol",
    "GA4_ENABLED": "false",
    "GA4_OAUTH_REDIRECT_URI": "https://surgeindex.lol/api/ga4/callback",
    "TRACKER_PUBLIC_URL": "https://surgeindex.lol/tracker.js",
    "TRACKER_COLLECTOR_URL": "https://surgeindex.lol/api/collect/v1/events",
    "STRIPE_ENABLED": "false",
    "STRIPE_CHECKOUT_SUCCESS_URL": "https://surgeindex.lol/dashboard/boosts/{CAMPAIGN_ID}?checkout=success",
    "STRIPE_CHECKOUT_CANCEL_URL": "https://surgeindex.lol/dashboard/boosts/{CAMPAIGN_ID}?checkout=cancel"
  }
}

# Canonical production configuration for surgeindex.lol.
# Copy to a private deployment environment or secret manager. Never commit the
# populated file. NEXT_PUBLIC_* values must also be present during the build.

NODE_ENV=production
APP_MODE=production
DATA_PROVIDER=postgres
ANALYTICS_PROVIDER=postgres
REALTIME_PROVIDER=local
QUEUE_PROVIDER=local

NEXT_PUBLIC_APP_NAME=SurgeIndex
NEXT_PUBLIC_APP_URL=https://surgeindex.lol
EXPECTED_MIGRATION_COUNT=14
TRUSTED_PROXY_MODE=direct_nginx

# Required secrets. Supply these through the deployment platform.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
DB_DRIVER=pg
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://surgeindex.lol

# Optional Google sign-in.
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# GA4 remains off until the OAuth app and encryption secrets are configured.
GA4_ENABLED=false
GA4_PROVIDER_MODE=google
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
GA4_OAUTH_REDIRECT_URI=https://surgeindex.lol/api/ga4/callback
GA4_TOKEN_ENCRYPTION_KEY=
GA4_TOKEN_ENCRYPTION_KEY_VERSION=v1

# First-party tracking remains off until its secrets and operational pipeline
# are provisioned. These URLs are already canonical-domain safe.
TRACKER_ENABLED=false
TRACKER_PUBLIC_URL=https://surgeindex.lol/tracker.js
TRACKER_COLLECTOR_URL=https://surgeindex.lol/api/collect/v1/events
TRACKER_HASH_SECRET=
TRACKER_SIGNING_SECRET=
TRACKER_KEY_ROTATION_SECRET=

# Payments remain off until live Stripe keys, webhook handling, pricing, tax,
# refund policy, and launch approval are complete.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_CHECKOUT_SUCCESS_URL=https://surgeindex.lol/dashboard/boosts/{CAMPAIGN_ID}?checkout=success
STRIPE_CHECKOUT_CANCEL_URL=https://surgeindex.lol/dashboard/boosts/{CAMPAIGN_ID}?checkout=cancel
STRIPE_TEST_MODE_REQUIRED=true

TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=true
TURNSTILE_EXPECTED_HOSTNAME=surgeindex.lol

# Optional public Radar context. The token must be a server-side, read-only
# Cloudflare token with Account > Radar > Read permission.
CLOUDFLARE_RADAR_API_TOKEN=
CLOUDFLARE_RADAR_API_BASE_URL=https://api.cloudflare.com/client/v4/radar
CLOUDFLARE_RADAR_REQUEST_TIMEOUT_MS=8000
CLOUDFLARE_RADAR_CACHE_SECONDS=300

# Transactional email is required before production auth is enabled.
EMAIL_PROVIDER=http
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_HTTP_URL=
EMAIL_HTTP_API_KEY=
EMAIL_HTTP_TIMEOUT_MS=8000

# Placement kill switches. Keep false until that public route and its staging
# delivery/read-back checks are complete.
BOOST_PLACEMENT_HOMEPAGE_ENABLED=false
BOOST_PLACEMENT_CATEGORY_ENABLED=false
BOOST_PLACEMENT_RANKING_ENABLED=false
BOOST_PLACEMENT_PROFILE_ENABLED=false
BOOST_PLACEMENT_BREAKOUT_ENABLED=false
PUBLIC_REVENUE_BOARD_ENABLED=false
PUBLIC_PAGE_METRICS_ENABLED=false

[Unit]
Description=Detect Boost underdelivery requiring review
Wants=network-online.target
After=network-online.target surgeindex.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/surgeindex/current
EnvironmentFile=/etc/surgeindex/surgeindex.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/surgeindex/current/dist/jobs/boost-underdelivery.mjs
TimeoutStartSec=120
RuntimeMaxSec=180
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

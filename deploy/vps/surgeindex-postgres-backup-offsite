#!/bin/sh
set -eu

umask 077
: "${BACKUP_S3_BUCKET:?BACKUP_S3_BUCKET is required}"
: "${BACKUP_AGE_RECIPIENT:?BACKUP_AGE_RECIPIENT is required}"
: "${BACKUP_S3_PREFIX:?BACKUP_S3_PREFIX is required}"
: "${BACKUP_CONTAINER:=surgeindex-db}"
: "${BACKUP_TMP_DIR:=/var/backups/surgeindex/offsite}"

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
mkdir -p "$BACKUP_TMP_DIR"
temporary="$BACKUP_TMP_DIR/.surgeindex-$timestamp.dump.age.tmp"
final="$BACKUP_TMP_DIR/surgeindex-$timestamp.dump.age"

cleanup() { rm -f "$temporary"; }
trap cleanup EXIT HUP INT TERM

docker exec "$BACKUP_CONTAINER" sh -ceu \
  'exec pg_dump --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --format=custom --no-owner --no-privileges' \
  | age --encrypt --recipient "$BACKUP_AGE_RECIPIENT" > "$temporary"
test -s "$temporary"
mv "$temporary" "$final"
trap - EXIT HUP INT TERM

destination="s3://${BACKUP_S3_BUCKET}/${BACKUP_S3_PREFIX%/}/$(basename "$final")"
if [ -n "${BACKUP_S3_ENDPOINT:-}" ]; then
  aws s3 cp "$final" "$destination" --endpoint-url "$BACKUP_S3_ENDPOINT" --only-show-errors
else
  aws s3 cp "$final" "$destination" --only-show-errors
fi
test -s "$final"
find "$BACKUP_TMP_DIR" -type f -name 'surgeindex-*.dump.age' -mtime +7 -delete
echo "Encrypted offsite backup uploaded: $(basename "$final")"

[Unit]
Description=Compute SurgeIndex scores, breakouts, and rankings
Wants=network-online.target
After=network-online.target surgeindex.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/surgeindex/current
EnvironmentFile=/etc/surgeindex/surgeindex.env
EnvironmentFile=-/etc/surgeindex/turnstile.production.env
EnvironmentFile=-/etc/surgeindex/resend.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--conditions=react-server
ExecStart=/usr/bin/node /opt/surgeindex/current/dist/jobs/run-scoring-jobs.mjs
TimeoutStartSec=240
RuntimeMaxSec=300
MemoryMax=768M
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

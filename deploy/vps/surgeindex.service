[Unit]
Description=SurgeIndex Next.js production service
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/surgeindex/current/apps/web
EnvironmentFile=/etc/surgeindex/surgeindex.env
EnvironmentFile=-/etc/surgeindex/turnstile.production.env
EnvironmentFile=-/etc/surgeindex/resend.env
EnvironmentFile=-/opt/surgeindex/current/release.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /opt/surgeindex/current/apps/web/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3211
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
SuccessExitStatus=130
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectHome=true
ReadWritePaths=/opt/surgeindex
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

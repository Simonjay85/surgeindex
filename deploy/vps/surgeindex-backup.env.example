# Root-owned /etc/surgeindex/backup.env. Populate through the host secret
# manager; never commit the populated file.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=surgeindex/postgres
BACKUP_S3_ENDPOINT=
BACKUP_AGE_RECIPIENT=
BACKUP_AGE_IDENTITY_FILE=/etc/surgeindex/backup.agekey
BACKUP_CONTAINER=surgeindex-db
BACKUP_TMP_DIR=/var/backups/surgeindex/offsite

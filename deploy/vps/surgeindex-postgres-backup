#!/bin/sh
set -eu

umask 077

backup_dir=/var/backups/surgeindex/postgres
timestamp=$(date -u +%Y%m%dT%H%M%SZ)
temporary_backup="$backup_dir/.surgeindex-$timestamp.dump.tmp"
final_backup="$backup_dir/surgeindex-$timestamp.dump"

mkdir -p "$backup_dir"

cleanup() {
  rm -f "$temporary_backup"
}
trap cleanup EXIT HUP INT TERM

docker exec surgeindex-db sh -ceu \
  'exec pg_dump --username "$POSTGRES_USER" --dbname "$POSTGRES_DB" --format=custom --no-owner --no-privileges' \
  > "$temporary_backup"

test -s "$temporary_backup"
mv "$temporary_backup" "$final_backup"
trap - EXIT HUP INT TERM

find "$backup_dir" -type f -name 'surgeindex-*.dump' -mtime +14 -delete
backup_size_bytes=$(stat -c '%s' "$final_backup")
printf 'backup_timestamp=%s backup_file=%s backup_size_bytes=%s upload_result=PENDING verify_result=PENDING restore_result=PENDING rpo=PENDING_OWNER_APPROVAL rto=PENDING_OWNER_APPROVAL\n' \
  "$timestamp" "$(basename "$final_backup")" "$backup_size_bytes"

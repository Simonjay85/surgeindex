[Unit]
Description=Aggregate SurgeIndex first-party traffic
Wants=network-online.target
After=network-online.target surgeindex.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/surgeindex/current
EnvironmentFile=/etc/surgeindex/surgeindex.env
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--conditions=react-server
ExecStart=/opt/surgeindex/current/node_modules/.bin/tsx scripts/run-traffic-aggregation.ts
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardOutput=journal
StandardError=journal

[Unit]
Description=Verify the latest encrypted SurgeIndex PostgreSQL backup
Wants=network-online.target
After=network-online.target surgeindex-postgres-backup-offsite.service

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/surgeindex/backup.env
ExecStart=/usr/local/sbin/surgeindex-postgres-backup-verify
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/surgeindex/verify
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=journal
StandardError=journal

# ─────────────────────────────────────────────────────────────────────────────
# SurgeIndex environment configuration
# Copy to apps/web/.env and fill in. Variables marked [demo] are the only ones
# required for local development with APP_MODE=demo and DATA_PROVIDER=demo.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# Application mode is explicit. Demo mode is deterministic and does not touch
# PostgreSQL. Production mode requires DATA_PROVIDER=postgres and a database.
# Docker Compose database settings. Keep the bind address loopback-only on a VPS.
POSTGRES_USER=surgeindex_local
POSTGRES_PASSWORD=replace-me-local-only
POSTGRES_DB=surgeindex
SURGEINDEX_DB_BIND_ADDRESS=127.0.0.1
SURGEINDEX_DB_PORT=55433

APP_MODE=demo
DATA_PROVIDER=demo
EXPECTED_MIGRATION_COUNT=15
TRUSTED_PROXY_MODE=none
TURNSTILE_REQUIRED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
EMAIL_PROVIDER=disabled
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_HTTP_URL=
EMAIL_HTTP_API_KEY=
BOOST_PLACEMENT_HOMEPAGE_ENABLED=true
BOOST_PLACEMENT_CATEGORY_ENABLED=true
BOOST_PLACEMENT_RANKING_ENABLED=true
BOOST_PLACEMENT_PROFILE_ENABLED=true
BOOST_PLACEMENT_BREAKOUT_ENABLED=true
PUBLIC_REVENUE_BOARD_ENABLED=false
PUBLIC_PAGE_METRICS_ENABLED=false
ANALYTICS_PROVIDER=postgres
REALTIME_PROVIDER=local
REALTIME_SERVICE_URL=
QUEUE_PROVIDER=local
TRACKER_ENABLED=false

# Public app identity [demo]
NEXT_PUBLIC_APP_NAME=SurgeIndex
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMMERCIAL_ENABLED=false
# Canonical production values live in apps/web/.env.production.example. Keep
# localhost here so the default local development flow remains self-contained.

# ── Database (required when DATA_PROVIDER=postgres) ─────────────────────────
# Local dev uses the docker-compose Postgres. Production can point at Neon.
DATABASE_URL=postgresql://surgeindex_local:replace-me-local-only@localhost:55433/surgeindex
# Direct (non-pooled) connection for migrations. Neon: the direct URL.
DATABASE_URL_UNPOOLED=postgresql://surgeindex_local:replace-me-local-only@localhost:55433/surgeindex
# pg = node-postgres (default) | neon = @neondatabase/serverless (Workers)
DB_DRIVER=pg

# ── Auth (required) ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set to your app URL in production (https://surgeindex.lol for this deployment)
BETTER_AUTH_URL=http://localhost:3000
# Google sign-in (optional — email/password works without it)
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=

# ── GA4 integration (fixture in demo; Google credentials only on the server) ─
GA4_ENABLED=false
GA4_PROVIDER_MODE=fixture
GA4_OAUTH_CLIENT_ID=
GA4_OAUTH_CLIENT_SECRET=
GA4_OAUTH_REDIRECT_URI=http://localhost:3000/api/ga4/callback
GA4_TOKEN_ENCRYPTION_KEY=
GA4_TOKEN_ENCRYPTION_KEY_VERSION=v1
GA4_TOKEN_ENCRYPTION_KEY_PREVIOUS=
GA4_TOKEN_ENCRYPTION_KEY_PREVIOUS_VERSION=
GA4_ADMIN_API_BASE_URL=https://analyticsadmin.googleapis.com/v1beta
GA4_DATA_API_BASE_URL=https://analyticsdata.googleapis.com/v1beta
GA4_INITIAL_BACKFILL_DAYS=90
GA4_CORE_SYNC_INTERVAL_MINUTES=60
GA4_REALTIME_SYNC_INTERVAL_MINUTES=5
GA4_MAX_PROPERTIES_PER_USER=100
GA4_MAX_PARALLEL_REQUESTS=4
GA4_REQUEST_TIMEOUT_MS=8000
GA4_SOURCE_SWITCH_LOCK_DAYS=14
GA4_SOURCE_OVERLAP_REVIEW_DAYS=7
GA4_STALE_AFTER_MINUTES=180
GA4_OFFLINE_AFTER_HOURS=48
# Legacy names retained only for older deployments; Batch 5 does not use them.
GOOGLE_ANALYTICS_CLIENT_ID=
GOOGLE_ANALYTICS_CLIENT_SECRET=
OAUTH_TOKEN_ENCRYPTION_KEY=

# ── Tinybird event analytics (optional — Postgres demo adapter used if unset)
TINYBIRD_API_URL=
TINYBIRD_INGEST_TOKEN=
TINYBIRD_READ_TOKEN=

# ── First-party traffic pipeline ────────────────────────────────────────────
# Production requires explicit 32+ character secrets when TRACKER_ENABLED=true.
TRACKER_PUBLIC_URL=/tracker.js
TRACKER_COLLECTOR_URL=/api/collect/v1/events
TRACKER_HASH_SECRET=
TRACKER_SIGNING_SECRET=
TRACKER_KEY_ROTATION_SECRET=
# TRACKER_HASH_SALT is retained as a legacy alias for local upgrades.
TRACKER_HASH_SALT=
HEARTBEAT_INTERVAL_SECONDS=30
ACTIVE_SESSION_TTL_SECONDS=90
ENGAGED_SESSION_SECONDS=10
ATTRIBUTION_TTL_MINUTES=30
TRACKER_EVENT_MAX_BATCH_SIZE=20
TRACKER_EVENT_MAX_BODY_BYTES=65536
EVENT_RETENTION_DAYS=90

# Queue/provider boundaries. Set QUEUE_PROVIDER=cloudflare only when the
# collector/consumer Workers and the internal ingest URL are provisioned.
CLOUDFLARE_QUEUE_NAME=surgeindex-events
CLOUDFLARE_DLQ_NAME=surgeindex-events-dlq
INTERNAL_INGEST_URL=
INTERNAL_SERVICE_TOKEN=

# ── Boost + Stripe (disabled until pricing and launch approvals are complete) ─
BOOST_ENABLED=false
BOOST_LIVE_MODE_ENABLED=false
BOOST_DEFAULT_CURRENCY=USD
BOOST_INVENTORY_TIME_ZONE=UTC
BOOST_RESERVATION_MINUTES=30
BOOST_DEFAULT_CAMPAIGN_DAYS=7
BOOST_MAX_CAMPAIGN_DAYS=30
BOOST_MAX_FREQUENCY_PER_VISITOR_PER_DAY=3
BOOST_IMPRESSION_VISIBILITY_PERCENT=50
BOOST_IMPRESSION_VISIBILITY_MS=1000
BOOST_ATTRIBUTION_WINDOW_MINUTES=30
BOOST_MAX_OVERDELIVERY_PERCENT=10
BOOST_UNDERDELIVERY_GRACE_DAYS=2
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_API_VERSION=2025-06-30.basil
STRIPE_CHECKOUT_SUCCESS_URL=
STRIPE_CHECKOUT_CANCEL_URL=
STRIPE_TEST_MODE_REQUIRED=true
STRIPE_TAX_ENABLED=false
BOOST_STARTER_PRICE_ID=
BOOST_GROWTH_PRICE_ID=
BOOST_LAUNCH_PRICE_ID=

# ── Cloudflare Turnstile (optional — public form protection) ─────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cloudflare deployment (optional) ─────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Cloudflare Radar uses a separate read-only token with Account > Radar > Read.
# Keep this server-side; it is never sent to the browser.
CLOUDFLARE_RADAR_API_TOKEN=
CLOUDFLARE_RADAR_API_BASE_URL=https://api.cloudflare.com/client/v4/radar
CLOUDFLARE_RADAR_REQUEST_TIMEOUT_MS=8000
CLOUDFLARE_RADAR_CACHE_SECONDS=300
# Secret shared only by the Collector Worker and the Realtime Durable Object.
REALTIME_SIGNAL_TOKEN=

# Heat score version tag stored with snapshots
SCORE_VERSION=v1

# ── Feature flags ───────────────────────────────────────────────────────────
# Safe local/Public Free defaults remain off. The approved Fanward staging and
# production profile enables FEATURE_CREATORS only; all commercial/future
# modules below remain disabled.
FEATURE_CREATORS=false
FEATURE_CAMPAIGNS=false
FEATURE_AUCTION=false
FEATURE_PUBLIC_API=false

{
  "name": "surgeindex",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm -F web dev",
    "build": "pnpm tracker:build && pnpm -F web build && pnpm jobs:build",
    "start": "pnpm -F web start",
    "preview": "pnpm -F web preview",
    "deploy": "pnpm -F web deploy",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -F web lint",
    "test": "pnpm -r --parallel test",
    "test:e2e": "pnpm -F web test:e2e",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm -F @surge/db generate",
    "db:migrate": "pnpm -F @surge/db migrate",
    "db:studio": "pnpm -F @surge/db studio",
    "db:seed": "tsx --env-file=apps/web/.env scripts/seed.ts",
    "admin:promote": "tsx --env-file=apps/web/.env scripts/promote-admin.ts",
    "demo:events": "tsx --env-file=apps/web/.env scripts/generate-demo-events.ts",
    "ranks:recompute": "tsx --env-file=apps/web/.env scripts/recompute-ranks.ts",
    "scoring:run": "NODE_OPTIONS=--conditions=react-server tsx --env-file=apps/web/.env scripts/run-scoring-jobs.ts",
    "scoring:backfill": "tsx --env-file=apps/web/.env scripts/backfill-scoring.ts",
    "ranking:evaluate": "tsx scripts/evaluate-scoring.ts",
    "ranking:benchmark": "tsx scripts/evaluate-scoring.ts",
    "ranking:baseline": "tsx --env-file=apps/web/.env scripts/run-scoring-job.ts --job=baseline",
    "ranking:score": "tsx --env-file=apps/web/.env scripts/run-scoring-job.ts --job=score",
    "ranking:snapshot": "tsx --env-file=apps/web/.env scripts/run-scoring-job.ts --job=ranking",
    "ranking:breakouts": "tsx --env-file=apps/web/.env scripts/run-scoring-job.ts --job=breakout",
    "ranking:recompute": "tsx --env-file=apps/web/.env scripts/backfill-scoring.ts",
    "ranking:backfill": "tsx --env-file=apps/web/.env scripts/backfill-scoring.ts",
    "tracker:build": "pnpm -F @surge/tracker build",
    "tracker:test": "pnpm -F @surge/tracker test",
    "traffic:aggregate": "NODE_OPTIONS=--conditions=react-server tsx --env-file=apps/web/.env scripts/run-traffic-aggregation.ts",
    "traffic:load": "tsx scripts/load-tracker-events.ts",
    "ga4:fixture": "tsx scripts/ga4-fixture.ts",
    "ga4:sync": "tsx --env-file=apps/web/.env scripts/ga4-sync.ts",
    "ga4:realtime": "tsx --env-file=apps/web/.env scripts/ga4-realtime.ts",
    "ga4:backfill": "tsx --env-file=apps/web/.env scripts/ga4-backfill.ts",
    "ga4:health": "tsx --env-file=apps/web/.env scripts/ga4-health.ts",
    "boost:fixture": "tsx scripts/boost-fixture.ts",
    "boost:forecast": "tsx --env-file=apps/web/.env scripts/boost-forecast.ts",
    "boost:pace": "tsx --env-file=apps/web/.env scripts/boost-pace.ts",
    "boost:aggregate": "tsx --env-file=apps/web/.env scripts/boost-aggregate.ts",
    "boost:complete": "tsx --env-file=apps/web/.env scripts/boost-complete.ts",
    "boost:underdelivery": "tsx --env-file=apps/web/.env scripts/boost-underdelivery.ts",
    "boost:reconcile-payments": "tsx --env-file=apps/web/.env scripts/boost-reconcile-payments.ts",
    "boost:release-reservations": "tsx --env-file=apps/web/.env scripts/boost-release-reservations.ts",
    "stripe:test-webhook": "tsx scripts/stripe-test-webhook.ts",
    "stripe:replay-event": "tsx --env-file=apps/web/.env scripts/stripe-replay-event.ts",
    "boost:placement-check": "node scripts/boost-placement-check.mjs",
    "security:scan": "node scripts/secret-scan.mjs",
    "db:test": "node scripts/database-tests.mjs",
    "db:smoke": "tsx scripts/migration-smoke.ts",
    "production:import": "tsx scripts/import-production-sites.ts",
    "launch:gates": "node scripts/launch-gates.mjs",
    "launch:gates:public-free": "node scripts/launch-gates.mjs --strict-public-free",
    "launch:gates:fanward": "node scripts/launch-gates.mjs --strict-fanward-mvp",
    "launch:check": "node scripts/launch-check.mjs",
    "staging:readback": "node scripts/staging-readback.mjs",
    "fanward:readback": "node scripts/fanward-readback.mjs",
    "fanward:fixture": "node --import tsx scripts/fanward-staging-fixture.ts",
    "jobs:build": "node scripts/build-production-jobs.mjs",
    "jobs:smoke": "node scripts/job-artifact-smoke.mjs"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@surge/boost": "workspace:*",
    "@surge/config": "workspace:*",
    "@surge/db": "workspace:*",
    "@surge/ga4": "workspace:*",
    "@surge/shared": "workspace:*",
    "drizzle-orm": "0.45.2",
    "esbuild": "0.28.2",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
